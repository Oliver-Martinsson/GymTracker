@page "/routines/new"
@rendermode InteractiveServer
@using GymTracker.Core.Interfaces
@using GymTracker.Core.Models
@inject IWorkoutRepository WorkoutRepo
@inject NavigationManager Navigation



<h3>AddRoutine</h3>

<PageTitle>New Routine</PageTitle>

<div class="routines-page">
    <h1 class="mb-4">New Routines</h1>
    
    <EditForm Model="_newRoutine" OnValidSubmit="Save">
        <div class="mb-3">
            <label class="form-label">Routine Name</label>
            <InputText @bind-Value="_newRoutine.Name" class="form-control" placeholder="e.g Push Day"/>
        </div>
        <button type="submit" class="btn btn-primary">save</button>
        <a href="/routines" class="btn btn-link">Cancel</a>
    </EditForm>
</div>


@code {
    private readonly Workout _newRoutine = new();

    private async Task Save()
    {
        if (string.IsNullOrEmpty(_newRoutine.Name))
            return;
        
        await WorkoutRepo.AddAsync(_newRoutine);
        Navigation.NavigateTo("/routines");
    }
}