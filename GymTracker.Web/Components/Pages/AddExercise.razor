@page "/routines/{Id:int}/add-exercise"
@using GymTracker.Core.Interfaces
@using GymTracker.Core.Models
@rendermode InteractiveServer
@inject IExerciseService ExerciseService
@inject IWorkoutRepository WorkoutRepo
@inject NavigationManager Navigation


<h3>AddExercise</h3>

<input class="form-control form-control-lg mb-3"
       placeholder="Search exercise..."
       @bind="_searchTerm" @bind:event="oninput" @bind:after="RunSearch" />

<div class="d-flex gap-2 mb-3">
       <button class="btn flex-fill @(string.IsNullOrEmpty(_selectedEquipment) ? "btn-outline-secondary" : "btn-secondary")"
               @onclick="OpenEquipment">
              @(string.IsNullOrEmpty(_selectedEquipment) ? "Equipment" : _selectedEquipment)
       </button>
       <button class="btn flex-fill @(string.IsNullOrEmpty(_selectedBodyPart) ? "btn-outline-secondary" : "btn-secondary")"
               @onclick="OpenMuscles">
              @(string.IsNullOrEmpty(_selectedBodyPart) ? "Muscles" : _selectedBodyPart)
       </button>
</div>

<div class="list-group">
       @foreach (var exercise in _results)
       {
              <div class="list-group-item d-flex align-items-center py-3">
                     <button class="btn btn-link text-start flex-fill text-decoration-none fw-semibold p-0"
                             @onclick="() => Toggle(exercise.Id)">
                            @exercise.Name
                            @if (_selectedIds.Contains(exercise.Id))
                            {
                                   <span class="text-success ms-2">✓</span>
                            }
                     </button>
                     <a href="@($"/exercises/{exercise.Id}")" class="btn btn-sm btn-outline-secondary ms-2">
                            i
                     </a>
              </div>
       }
       @if (_results.Count == 0)
       {
       <div class="list-group-item text-secondary">No Exercises Found</div>
       }
</div>
@if (_selectedIds.Count > 0)
{
       <div class="position-fixed start-0 end-0 p-3 bg-body border-top" style="bottom: 2rem;">
              <button class="btn btn-primary btn-lg w-100" @onclick="Save">
                     Add @_selectedIds.Count exercise@(_selectedIds.Count == 1 ? "" : "s")
              </button>
       </div>
}

@if (_showEquipment || _showMuscles)
{
       <div class="offcanvas-backdrop fade show" @onclick="CloseSheets"></div>
       <div class="position-fixed start-0 end-0 bottom-0 bg-body rounded-top shadow"
            style="z-index: 1050; max-height: 70vh; overflow-y: auto;">
              <div class="d-flex align-items-center justify-content-between p-3 border-bottom">
                     <h6 class="m-0">@(_showEquipment ? "Choose Equipment" : "Choose Muscle Group")</h6>
                     <button class="btn-close" @onclick="CloseSheets"></button>
              </div>
              <div class="list-group list-group-flush">
                     <button class="list-group-item list-group-item-action py-3" @onclick="() => SelectOption(string.Empty)">All</button>
                     @foreach (var opt in (_showEquipment ? _equipment : _bodyParts))
                     {
                            <button class="list-group-item list-group-item-action py-3 text-capitalize" @onclick="() => SelectOption(opt)">@opt</button>
                     }
              </div>
       </div>
       
}
@code {
    [Parameter] public int Id { get; set; }
    private const int DefaultSets = 3;
    private const int DefaultReps = 10;
    private readonly HashSet<string> _selectedIds = new();
    private string _selectedBodyPart = "";
    private string _selectedEquipment = "";
    private bool _showEquipment;
    private bool _showMuscles;
    
    private readonly string[] _bodyParts =
           [ "back", "chest", "shoulders", "upper arms", "lower arms", "upper legs", "lower legs", "waist", "neck", "cardio"];

    private readonly string[] _equipment =
           ["barbell", "dumbbell", "cable", "body weight", "kettlebell", "smith machine", "leverage machine", "band", "resistance band", "ez barbell" ];

    private void Toggle(string exerciseId)
    {
           if (!_selectedIds.Add(exerciseId)) 
                  _selectedIds.Remove(exerciseId);
    }

    private string _searchTerm = "";
    private List<Exercise> _results = new();
    protected override async Task OnInitializedAsync()
    {
           _results = await ExerciseService.GetAllAsync();
    }

    private async Task Save()
    {
           if (_selectedIds.Count == 0) return;
           var routine = await WorkoutRepo.GetByIdAsync(Id);
           if (routine is null) return;

           foreach (var exerciseId in _selectedIds)
           {
                  routine.WorkoutExercises.Add(new WorkoutExercise
                  {
                         ExerciseId = exerciseId,
                         Sets = DefaultSets,
                         Reps = DefaultReps
                         
                  });
           }
           
           await WorkoutRepo.UpdateAsync(routine);
           Navigation.NavigateTo($"/routines/{Id}");
    }
    private async Task RunSearch()
    {
           _selectedBodyPart = "";
           _selectedEquipment = "";
           _results = await ExerciseService.SearchAsync(_searchTerm);
    }

    private void OpenEquipment() { _showEquipment = true; _showMuscles = false; }
    private void OpenMuscles()   { _showMuscles = true;  _showEquipment = false; }
    private void CloseSheets()   { _showEquipment = false; _showMuscles = false; }

    private async Task SelectOption(string value)
    {
           if (_showEquipment)
           {
                  _selectedEquipment = value;
           }
           else
           {
                  _selectedBodyPart = value;
           }
           
           CloseSheets();
           _searchTerm = "";
           await ApplyFilter();
    }

    private async Task ApplyFilter()
    {
           if (string.IsNullOrEmpty(_selectedBodyPart) && string.IsNullOrEmpty(_selectedEquipment))
           {
                  _results = await ExerciseService.GetAllAsync();
           }
           else 
           {
                  _results = await ExerciseService.FilterAsync(_selectedBodyPart, _selectedEquipment); 
           }
    }

}