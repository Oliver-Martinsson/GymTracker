@page "/Routines/{Id:int}"
@rendermode InteractiveServer
@using GymTracker.Core.Models
@using GymTracker.Core.Interfaces
@inject IWorkoutRepository Repo
@inject IExerciseService ExerciseService
@inject NavigationManager Nav

<h3>Routine</h3>

@if (_routine is null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="routines-page">
        <h1 class="mb-4">@_routine.Name</h1>
        
         <div class="card mb-4">
            <div class="list-group list-group-flush">
                @foreach (var workoutex in _routine.WorkoutExercises)
                {
                    <div class="list-group-item d-flex align-items-center py-3">
                        <span class="fw-semibold">@GetExerciseName(workoutex.ExerciseId)</span>
                        
                        <span class="ms-auto text-secondary"></span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveExercise(workoutex.Id)">Delete</button>
                    </div>
                }
                @if (_routine.WorkoutExercises.Count == 0)
                {
                    <div class="list-group-item text-secondary">No exercise yet</div>
                }
            </div>
        </div>
        
        <div class="d-flex justify-content-center my-4">
            <button class="btn btn-primary btn-lg" 
                    @onclick="@(() => Nav.NavigateTo($"/AddExercise/{Id}/add-exercise"))"> + Add Exercise</button>
        </div>
        
        <a href="/routines" class="btn btn-link mt-3">Back</a>
    </div>
}

@code {

    
    
    [Parameter] public int  Id { get; set; }
    
    private Workout? _routine;

    protected override async Task OnInitializedAsync()
    {
        _routine = await Repo.GetByIdAsync(Id);
        
        await LoadNames();
    }

    private string GetExerciseName(string exerciseId)
     => _exerciseNames.TryGetValue(exerciseId, out var name) ? name : "Unknown";
    
    private async Task RemoveExercise(int workoutExerciseId)
    {
        await Repo.RemoveExerciseAsync(workoutExerciseId);
        _routine = await Repo.GetByIdAsync(Id);
    }

    
    private readonly Dictionary<string, string> _exerciseNames = new();

    private async Task LoadNames()
    {
        if (_routine is  null)
            return;
        foreach (var we in _routine.WorkoutExercises)
        {
            if (!_exerciseNames.ContainsKey(we.ExerciseId))
            {
                var ex = await ExerciseService.GetByIdAsync(we.ExerciseId);
                _exerciseNames[we.ExerciseId] = ex?.Name ?? "Unknown";
            }
        }
    }
    


}