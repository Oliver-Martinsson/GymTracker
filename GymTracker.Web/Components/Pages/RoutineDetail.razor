@page "/Routines/{Id:int}"
@rendermode InteractiveServer
@using GymTracker.Core.Models
@using GymTracker.Core.Interfaces
@inject IWorkoutRepository Repo
@inject IExerciseService ExerciseService

<h3>Routine</h3>

@if (routine is null)
{
    <div class="d-flex justify-content-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="routines-page">
        <h1 class="mb-4">@routine.Name</h1>
        
         <div class="card mb-4">
            <div class="list-group list-group-flush">
                @foreach (var workoutex in routine.WorkoutExercises)
                {
                    <div class="list-group-item d-flex align-items-center py-3">
                        <span class="fw-semibold">@GetExerciseName(workoutex.ExerciseId)</span>
                        
                        <span class="ms-auto text-secondary"></span>
                        <button class="btn btn-outline-danger btn-sm" @onclick="() => RemoveExercise(workoutex.Id)">Delete</button>
                    </div>
                }
                @if (routine.WorkoutExercises.Count == 0)
                {
                    <div class="list-group-item text-secondary">No exercise yet</div>
                }
            </div>
        </div>
        
        <select @bind="selectedBodyPart" @bind:after="SendFilter" class="form-select mb-2">
            <option value="">All Muscle Groups</option>
            @foreach (var bp in bodyParts)
            {
                <option value="@bp">@bp</option>
            }
        </select>
        <select @bind="selectedEquipment" @bind:after ="SendFilter" class="form-select mb-2">
            <option value="">All Equipment</option>
            @foreach (var eq in equipment)
            {
                <option value="@eq">@eq</option>
            }
        </select>
        
        
        
        
        
        <div class="d-flex gap-2">
            <select @bind="selectedExerciseId" class="form-select">
                <option value="">Choose an exercise...</option>
                @foreach (var ex in allExercises)
                {
                    <option value="@ex.Id">@ex.Name</option>
                }
            </select>
            <button class="btn btn-primary" @onclick="AddExercise">Add</button>
        </div>
        
        <a href="/routines" class="btn btn-link mt-3">Back</a>
    </div>
}

@code {

    private string selectedBodyPart = "";
    private string selectedEquipment = "";
    
    
    [Parameter] public int  Id { get; set; }
    
    private Workout? routine;
    private List<Exercise> allExercises = new();
    private string selectedExerciseId = "";

    protected override async Task OnInitializedAsync()
    {
        routine = await Repo.GetByIdAsync(Id);
        allExercises = await ExerciseService.GetAllAsync();
        await LoadNames();
    }

    private string GetExerciseName(string exerciseId)
     => exerciseNames.TryGetValue(exerciseId, out var name) ? name : "Unknown";

    private async Task AddExercise()
    {
        if (routine == null || string.IsNullOrEmpty(selectedExerciseId))
            return;

        routine.WorkoutExercises.Add(new WorkoutExercise
        {
            ExerciseId = selectedExerciseId,
            Sets = 3,
            Reps = 10
        });

        await Repo.UpdateAsync(routine);
        selectedExerciseId = "";
        await LoadNames();

    }
    
    private async Task RemoveExercise(int workoutExerciseId)
    {
        await Repo.RemoveExerciseAsync(workoutExerciseId);
        routine = await Repo.GetByIdAsync(Id);
    }

    
    private Dictionary<string, string> exerciseNames = new();
    
    
    private readonly string[] bodyParts =
    { "back", "chest", "shoulders", "upper arms", "lower arms", "upper legs", "lower legs", "waist", "neck", "cardio"};

    private readonly string[] equipment =
        {"barbell", "dumbbell", "cable", "body weight", "kettlebell", "smith machine", "leverage machine", "band", "resistance band", "ez barbell" };


    private async Task SendFilter()
    {
        allExercises = await ExerciseService.FilterAsync(selectedBodyPart, selectedEquipment);
        selectedExerciseId = "";
        await LoadNames();
    }

    private async Task LoadNames()
    {
        if (routine is  null)
            return;
        foreach (var we in routine.WorkoutExercises)
        {
            if (!exerciseNames.ContainsKey(we.ExerciseId))
            {
                var ex = await ExerciseService.GetByIdAsync(we.ExerciseId);
                exerciseNames[we.ExerciseId] = ex.Name ?? "Unknown";
            }
        }
    }
    


};