@page "/routines"
@using GymTracker.Core.Interfaces
@rendermode InteractiveServer
@inject IWorkoutRepository WorkoutRepo
@using GymTracker.Core.Models
@inject IWorkoutSessionRepository SessionRepo
@inject NavigationManager Navigation


<PageTitle>Routines</PageTitle>

<div class="routines-page">
    <h1 class="mb-4">Your Routines</h1>
    <div class="card mb-4">

        <div class="list-group list-group-flush">
            <a href="/routines/new" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                <span class="icon-box me-3"></span>
                <span class="fw-semibold">New Routine</span>
                <span class="ms-auto text-secondary fs-5">&rsaquo;</span>
            </a>
        </div>
    </div>
    
    @if (_routines is null)
    {
        <p class="text-secondary">Loading...</p>
    }
    else if (_routines.Count == 0)
    {
        <p class="text-secondary">No Routines Yet.</p>
    }
    else
    {
        
        @foreach (var routine in _routines)
        {
            <div class="card mb-3">
                <div class="card-body d-flex align-items-center">
                    <a href="/routines/@routine.Id" class="text-decoration-none text-body flex-grow-1">
                        <h6 class="fw-semibold mb-1">@routine.Name</h6>
                        <p class="text-secondary small mb-0">@routine.WorkoutExercises.Count Exercises</p>
                    </a>
                    
                    
                    <button class="btn btn-success btn-sm me-2" @onclick="() => StartSession(routine.Id)">Start Workout</button>
                    
                    
                    <button class="btn btn-danger btn-sm" @onclick="() => ArchiveRoutine(routine.Id)">Delete</button>
                </div>
            </div>
        }
    }
</div>

@code
{
    private List<Workout>? _routines;

    protected override async Task OnInitializedAsync()
    {
        _routines = await WorkoutRepo.GetAllAsync();
    }

    private async Task ArchiveRoutine(int id)
    {
        await WorkoutRepo.ArchiveAsync(id);
        _routines = await WorkoutRepo.GetAllAsync();
    }


    private async Task StartSession(int id)
    {
        var session = await SessionRepo.StartSessionAsync(id);
        Navigation.NavigateTo($"/session/{session.Id}");
    }
    
}
