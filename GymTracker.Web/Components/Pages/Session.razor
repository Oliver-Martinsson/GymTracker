@page "/session/{Id:int}"
@using GymTracker.Core.Interfaces
@rendermode InteractiveServer
@inject IExerciseService ExerciseService
@using GymTracker.Core.Models
@using GymTracker.Core.Calculations
@inject IWorkoutSessionRepository SessionRepo


@if (_session is null)
{
    <p>Loading...</p>
}
else
{
    <h1 class="mb-4">@_session.Workout?.Name</h1>

    @foreach (var exerciseSets in _session.Sets.GroupBy(s => s.ExerciseId))
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <h6 class="fw-semibold">@GetExerciseName(exerciseSets.Key)</h6>
                    @if (exerciseSets.Any(s => s.Completed))
                    {
                        <span class="text-muted">1RM: @exerciseSets.Where(s => s.Completed).Max(s => OneRepMaxCalculator.Epley(s.Weight, s.Reps)).ToString("0.#") kg</span>
                    }
                </div>

                @foreach (var set in exerciseSets.OrderBy(s => s.SetNumber))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span>Set @set.SetNumber</span>

                        <input type="number" class="form-control" style="width: 90px"
                               @bind="set.Weight" @bind:after="() => SaveSet(set)"/>

                        <input type="number" class="form-control" style="width: 90px"
                               @bind="set.Reps" @bind:after="() => SaveSet(set)"/>

                        <input type="checkbox" class="form-check-input m-0" style="height: 2.375rem; width: 2.375rem"
                               @bind="set.Completed" @bind:after="() => SaveSet(set)"/>
                    </div>
                }
            </div>
        </div>
    }

    <a href="/routines" class="btn btn-outline-success mt-3">Finish</a>
}





@code {

    [Parameter] public int Id { get; set; }

    private WorkoutSession? _session;
    private readonly Dictionary<string, string> _exerciseNames = new();

    protected override async Task OnInitializedAsync()
    {
        _session = await SessionRepo.GetByIdAsync(Id);
        await LoadNames();
    }

    private string GetExerciseName(string exerciseId)
        => _exerciseNames.TryGetValue(exerciseId, out var name) ? name : "Unknown";

    private async Task LoadNames()
    {
        if (_session is null)
            return;
        foreach (var set in _session.Sets)
        {
            if (!_exerciseNames.ContainsKey(set.ExerciseId))
            {
                var exercise = await ExerciseService.GetByIdAsync(set.ExerciseId);
                _exerciseNames[set.ExerciseId] = exercise?.Name ?? "Unknown";
            }
        }
    }

    private async Task SaveSet(LoggedSet set)
        => await SessionRepo.UpdateSetAsync(set);

}